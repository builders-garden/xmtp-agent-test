{
  "name": "test-xmtp",
  "version": "1.0.0",
  "exports": "./dist/index.js",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node ./dist/index.js",
    "dev": "tsx watch ./src/index.ts",
